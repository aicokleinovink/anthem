# Anthem receiver IP control (TCP)
ANTHEM_HOST=192.168.2.3
ANTHEM_PORT=14999

# BluOS streamer (Bluesound Node) for now-playing info and transport controls.
# Leave empty to run without a player.
PLAYER_URL=http://192.168.2.15:11000

# HTTP server
PORT=3000

# Optional soft ceiling for volume writes, in dB. Unset means no API-side limit —
# the receiver's own Maximum Volume setting governs. Set it to clamp below that.
# MAX_VOLUME_DB=-60
